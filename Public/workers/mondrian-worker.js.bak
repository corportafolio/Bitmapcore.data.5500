/*
 * Mondrian Worker
 * Offloads CPU-intensive Mondrian generation to Web Worker
 */

importScripts('utils-advanced.js');

function generateMondrian(canvas, blockNumber, options, size) {
    const ctx = canvas.getContext('2d');
    size = size || 320;
    canvas.width = size;
    canvas.height = size;
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, size, size);

    const opts = options || {};
    const totalTransactions = opts.totalTransactions || 0;
    const hash = opts.hash || '';
    const isPerfect = opts.isPerfect || false;
    const isPunk = opts.isPunk || false;
    const etiquetas = opts.etiquetas || '';
    const transactions = opts.transactions || [];

    if (totalTransactions === 0 && transactions.length > 0) {
        return Promise.resolve(canvas.toDataURL());
    }
    let tx = totalTransactions;
    if (tx === 0) {
        tx = Math.abs(blockNumber % 7 + 3);
    }
    tx = Math.max(tx, 1);

    const labelsLower = etiquetas.toLowerCase();
    const is1Tx = labelsLower.split(/[|,]/).some(t => t.trim() === '1 tx');
    const is2Tx = labelsLower.split(/[|,]/).some(t => t.trim() === '2 tx');
    const isWideNeckPunk = labelsLower.indexOf('wide neck punk') !== -1;
    const isStandarPunk = labelsLower.indexOf('standar punk') !== -1;
    const isPristinePunk = labelsLower.indexOf('pristine punk') !== -1;
    const isPunk2tx = labelsLower.indexOf('punk 2tx') !== -1;
    const isSpecial2txPunk = isWideNeckPunk || isStandarPunk || isPristinePunk || isPunk2tx;

    if (tx === 1 && is1Tx) {
        return Promise.resolve(this._drawSpecial1TxWorker(canvas, size));
    } else if (tx === 2 && is2Tx && !isSpecial2txPunk) {
        return Promise.resolve(this._drawSpecial2TxWorker(canvas, size));
    } else if (tx === 2 && isSpecial2txPunk) {
        const neckType = isWideNeckPunk ? 1 : isStandarPunk ? 2 : isPristinePunk ? 3 : 4;
        return Promise.resolve(this._draw2txPunkWorker(canvas, size, neckType));
    } else if ((isPerfect || isPunk) && tx <= 35) {
        return Promise.resolve(this._drawPerfectGridWorker(canvas, tx, size, isPunk));
    } else {
        return Promise.resolve(this._drawMondrianPackingWorker(
            canvas, blockNumber, tx, hash, isPerfect, isPunk, size
        ));
    }
}

function postMessage(data) {
    window.postMessage(data, '*');
}

window.addEventListener('message', function(e) {
    const data = e.data;
    if (data.type === 'generate') {
        const canvas = new OffscreenCanvas(data.size, data.size);
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, data.size, data.size);

        const opts = data.options || {};
        let tx = opts.totalTransactions || 0;
        if (tx === 0) tx = Math.abs(data.blockNumber % 7 + 3);
        tx = Math.max(tx, 1);

        const labelsLower = (opts.etiquetas || '').toLowerCase();
        const is1Tx = labelsLower.split(/[|,]/).some(t => t.trim() === '1 tx');
        const is2Tx = labelsLower.split(/[|,]/).some(t => t.trim() === '2 tx');
        const isWideNeckPunk = labelsLower.indexOf('wide neck punk') !== -1;
        const isStandarPunk = labelsLower.indexOf('standar punk') !== -1;
        const isPristinePunk = labelsLower.indexOf('pristine punk') !== -1;
        const isPunk2tx = labelsLower.indexOf('punk 2tx') !== -1;
        const isSpecial2txPunk = isWideNeckPunk || isStandarPunk || isPristinePunk || isPunk2tx;

        if (tx === 1 && is1Tx) {
            window._drawSpecial1TxWorker(canvas, data.size);
        } else if (tx === 2 && is2Tx && !isSpecial2txPunk) {
            window._drawSpecial2TxWorker(canvas, data.size);
        } else if (tx === 2 && isSpecial2txPunk) {
            const neckType = isWideNeckPunk ? 1 : isStandarPunk ? 2 : isPristinePunk ? 3 : 4;
            window._draw2txPunkWorker(canvas, data.size, neckType);
        } else if ((opts.isPerfect || opts.isPunk) && tx <= 35) {
            if (tx === 1) {
                window._drawSingleCellWorker(canvas, data.size);
            } else {
                window._drawPerfectGridWorker(canvas, tx, data.size, opts.isPunk);
            }
        } else {
            window._drawMondrianPackingWorker(
                canvas, data.blockNumber, tx, data.hash, opts.isPerfect, opts.isPunk, data.size
            );
        }

        postMessage({
            type: 'generated',
            key: data.blockNumber + '_' + data.size + '_' + (data.options.hash || '') + '_' + (data.options.totalTransactions || 0) + '_' + (data.options.etiquetas || ''),
            dataURL: canvas.toDataURL()
        });
    }
});

if (typeof window._drawSpecial1TxWorker === 'undefined') {
    const worker = this;

    worker._drawSpecial1TxWorker = function(canvas, size) {
        var m = 5;
        var a = size - m * 2;
        canvas.getContext('2d').fillStyle = '#FE3E00';
        canvas.getContext('2d').fillRect(m, m, a, a);
    };

    worker._drawSpecial2TxWorker = function(canvas, size) {
        var m = 5;
        var aw = size - m * 2;
        var ah = size - m * 2;
        var totalH = 0.75 + 1.0;
        var h1 = ah * 0.75 / totalH;
        var h2 = ah * 1.0 / totalH;
        canvas.getContext('2d').fillStyle = '#FE3E00';
        canvas.getContext('2d').fillRect(m, m, aw, h1);
        canvas.getContext('2d').fillRect(m, m + h1 + m, aw, h2);
    };

    worker._draw2txPunkWorker = function(canvas, size, neckType) {
        var sideM = 40, tbM = 5;
        var aw = size - sideM * 2;
        var ah = size - tbM * 2;
        var proportion = neckType === 1 ? 0.75 : neckType === 3 ? 0.25 : 0.50;
        var h1 = (ah - tbM) / (1 + proportion);
        var h2 = h1 * proportion;
        canvas.getContext('2d').fillStyle = '#FE3E00';
        canvas.getContext('2d').fillRect(sideM, tbM, aw, h1);
        var tx2Left = neckType === 4 ? size - sideM - aw * proportion : sideM;
        canvas.getContext('2d').fillRect(tx2Left, tbM + h1 + tbM, aw * proportion, h2);
    };

    worker._drawSingleCellWorker = function(canvas, size) {
        var a = size - worker.BORDER * 2;
        canvas.getContext('2d').fillStyle = '#FE3E00';
        canvas.getContext('2d').fillRect(worker.BORDER, worker.BORDER, a, a);
    };

    worker._drawPerfectGridWorker = function(canvas, tx, size, isPunk) {
        var BASE = 5, EXTRA = 5, B = worker.BORDER;
        var spec = worker._getPerfectSpec(tx, isPunk);
        var cols = spec[0], rows = spec[1], mtb = spec[2], mside = spec[3], negras = spec[4];

        var aw = size - B * 2 - mside * 2;
        var ah = size - B * 2 - mtb * 2;
        var contentW = cols * BASE + Math.max(cols - 1, 0) * BASE;
        var contentH = rows * BASE + Math.max(rows - 1, 0) * BASE;
        var cellSize = Math.min((aw - contentW) / cols, (ah - contentH) / rows);
        cellSize = Math.max(cellSize, worker.MIN_PARCEL_PX);

        var actualW = cols * cellSize + Math.max(cols - 1, 0) * BASE;
        var filledRows = Math.ceil(tx / cols);
        var drawnH = filledRows * cellSize + Math.max(filledRows - 1, 0) * BASE;
        var oX = B + mside + (aw - actualW) / 2;
        var oY = B + mtb + (ah - drawnH) / 2;

        canvas.getContext('2d').fillStyle = '#FE3E00';
        var idx = 0;
        for (var r = 0; r < rows; r++) {
            for (var c = 0; c < cols; c++) {
                if (idx >= tx) return;
                var isInNeck = isPunk && negras > 0 && worker._isNeckCell(r, c, cols, rows, negras);
                if (!isInNeck) {
                    var x = oX + c * (cellSize + BASE);
                    var y = oY + r * (cellSize + BASE);
                    canvas.getContext('2d').fillRect(x, y, cellSize, cellSize);
                    idx++;
                }
            }
        }
    };

    worker._getPerfectSpec = MondrianGenerator._getPerfectSpec;
    worker._isNeckCell = MondrianGenerator._isNeckCell;
    worker.BORDER = MondrianGenerator.BORDER;
    worker.MIN_PARCEL_PX = MondrianGenerator.MIN_PARCEL_PX;

    worker._drawMondrianPackingWorker = function(canvas, blockNumber, tx, hash, isPerfect, isPunk, size) {
        var B = worker.BORDER;
        var hv = worker._hashCode(hash);
        var sizes = worker._getSizes(hash, tx, isPerfect);
        var adjusted = worker._adjustSizes(sizes);

        var totalArea = 0;
        for (var i = 0; i < adjusted.length; i++) totalArea += adjusted[i] * adjusted[i];
        var gridW = Math.max(Math.ceil(Math.sqrt(totalArea)), 1);
        var grid = [];
        for (var i = 0; i < gridW * gridW; i++) grid.push(false);

        var positions = [];
        var seed = (hv + blockNumber) || blockNumber;
        var rand = worker._seededRandom(seed);

        for (var i = 0; i < adjusted.length; i++) {
            var sz = Math.max(Math.round(adjusted[i]), 1);
            var placed = worker._placeLowest(grid, gridW, sz, positions);
            if (!placed) {
                worker._placeRandom(grid, gridW, sz, positions, rand);
            }
        }
        worker._applyGravity(grid, gridW, positions);

        var minC = Infinity, maxC = -Infinity, minR = Infinity, maxR = -Infinity;
        for (var i = 0; i < positions.length; i++) {
            var p = positions[i];
            if (p.col < minC) minC = p.col;
            if (p.col + p.size - 1 > maxC) maxC = p.col + p.size - 1;
            if (p.row < minR) minR = p.row;
            if (p.row + p.size - 1 > maxR) maxR = p.row + p.size - 1;
        }
        if (positions.length === 0) return;

        var usedW = Math.max(maxC - minC + 1, 1);
        var usedH = Math.max(maxR - minR + 1, 1);
        var cellW = (size - B * 2) / usedW;
        var cellH = (size - B * 2) / usedH;
        var padding = 0.5;

        canvas.getContext('2d').fillStyle = '#FE3E00';
        for (var i = 0; i < positions.length; i++) {
            var p = positions[i];
            var x = B + (p.col - minC) * cellW + padding;
            var y = B + (p.row - minR) * cellH + padding;
            var w = cellW * p.size - 2 * padding;
            var h = cellH * p.size - 2 * padding;
            if (w < 1) w = 1;
            if (h < 1) h = 1;
            canvas.getContext('2d').fillRect(x, y, w, h);
        }
    };

    worker._getSizes = MondrianGenerator._getSizes;
    worker._adjustSizes = MondrianGenerator._adjustSizes;
    worker._placeLowest = MondrianGenerator._placeLowest;
    worker._placeRandom = MondrianGenerator._placeRandom;
    worker._canPlace = MondrianGenerator._canPlace;
    worker._applyGravity = MondrianGenerator._applyGravity;
    worker._seededRandom = MondrianGenerator._seededRandom;
    worker._generateSimulatedWeights = MondrianGenerator._generateSimulatedWeights;
    worker._hashCode = MondrianGenerator._hashCode;
}

window.postMessage({
    type: 'worker-ready'
});